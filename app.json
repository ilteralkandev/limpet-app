{
  "expo": {
    "name": "Limpet",
    "slug": "LimpetApp",
    "scheme": "limpet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.limpetapp.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.limpetapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.limpetapp.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.limpetapp.app",
          "frequentUpdates": false,
          "enablePushNotifications": false
        }
      ],
      "./plugins/with-script-sandboxing-off",
      "expo-background-task",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "contentBaseUrl": "https://limpet-app.netlify.app"
    },
    "backgroundColor": "#0F3040"
  }
}
